+  async getHomepageStats() {
+    if (
+      !Services.prefs.getBoolPref(
+        "browser.contentblocking.database.enabled",
+        false
+      )
+    ) {
+      return null;
+    }
+
+    const eventRows = await lazy.TrackingDBService.getEventsByDateRange(
+      0,
+      Date.now()
+    );
+    const stats = this._aggregateStats(eventRows);
+    const result = { trackers: stats.trackers, cookies: stats.cookies };
+    const service = Cc["@mozilla.org/toolkit/profile-service;1"].getService(
+      Ci.nsIToolkitProfileService
+    );
+    if (service.isListOutdated) {
+      throw new Error("Profile list changed; restart to refresh privacy totals");
+    }
+    const current = Services.dirsvc.get("ProfD", Ci.nsIFile);
+    const seen = [current];
+    const { Sqlite } = ChromeUtils.importESModule(
+      "resource://gre/modules/Sqlite.sys.mjs"
+    );
+    for (const profile of service.profiles) {
+      const dir = profile.rootDir;
+      if (seen.some(item => item.equals(dir))) {
+        continue;
+      }
+      seen.push(dir);
+      const path = PathUtils.join(dir.path, "protections.sqlite");
+      if (!(await IOUtils.exists(path))) {
+        continue;
+      }
+      const db = await Sqlite.openConnection({ path, readOnly: true });
+      try {
+        const rows = await db.execute(
+          "SELECT type, SUM(count) AS count FROM events WHERE type IN (:trackers, :cookies) GROUP BY type",
+          {
+            trackers: Ci.nsITrackingDBService.TRACKERS_ID,
+            cookies: Ci.nsITrackingDBService.TRACKING_COOKIES_ID,
+          }
+        );
+        const other = this._aggregateStats(rows);
+        result.trackers += other.trackers;
+        result.cookies += other.cookies;
+      } finally {
+        await db.close();
+      }
+    }
+    return result;
+  },
+
   /**
    * Get today's tracking protection statistics.
    *
