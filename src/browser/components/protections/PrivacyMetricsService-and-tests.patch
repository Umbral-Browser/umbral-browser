+add_task(async function test_getHomepageStats_includes_records_older_than_a_week() {
+  const db = await Sqlite.openConnection({ path: DB_PATH });
+  const now = new Date();
+  const lastMonth = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);
+  await db.execute(SQL.insertCustomTimeEvent, {
+    type: TrackingDBService.TRACKERS_ID,
+    count: 6,
+    timestamp: now.toISOString(),
+  });
+  await db.execute(SQL.insertCustomTimeEvent, {
+    type: TrackingDBService.TRACKERS_ID,
+    count: 11,
+    timestamp: lastMonth.toISOString(),
+  });
+  await db.execute(SQL.insertCustomTimeEvent, {
+    type: TrackingDBService.TRACKING_COOKIES_ID,
+    count: 2,
+    timestamp: lastMonth.toISOString(),
+  });
+  await db.execute(SQL.insertCustomTimeEvent, {
+    type: TrackingDBService.CRYPTOMINERS_ID,
+    count: 8,
+    timestamp: lastMonth.toISOString(),
+  });
+  await db.close();
+
+  Assert.deepEqual(await PrivacyMetricsService.getHomepageStats(), {
+    trackers: 17,
+    cookies: 2,
+  });
+
+  await TrackingDBService.clearAll();
+  Assert.deepEqual(await PrivacyMetricsService.getHomepageStats(), {
+    trackers: 0,
+    cookies: 0,
+  });
+});
