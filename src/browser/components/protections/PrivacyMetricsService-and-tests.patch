+add_task(async function test_registered_profiles_totals() {
+  const service = Cc["@mozilla.org/toolkit/profile-service;1"].getService(
+    Ci.nsIToolkitProfileService
+  );
+  const dirs = [];
+  const profiles = [];
+  const writers = [];
+  try {
+    for (let i = 0; i < 2; i++) {
+      const dir = testAppData.clone();
+      dir.append(`test-profile-${i}`);
+      dir.create(Ci.nsIFile.DIRECTORY_TYPE, 0o700);
+      dirs.push(dir);
+      profiles.push(service.createProfile(dir, `test-profile-${i}`, "tests"));
+      const db = await Sqlite.openConnection({
+        path: PathUtils.join(dir.path, "protections.sqlite"),
+      });
+      writers.push(db);
+      await db.execute("CREATE TABLE events (id INTEGER PRIMARY KEY, type INTEGER NOT NULL, count INTEGER NOT NULL, timestamp DATE)");
+      await db.execute(SQL.insertCustomTimeEvent, {
+        type: TrackingDBService.TRACKERS_ID, count: 10 + i, timestamp: "2020-01-01",
+      });
+      await db.execute(SQL.insertCustomTimeEvent, {
+        type: TrackingDBService.TRACKING_COOKIES_ID, count: 3 + i, timestamp: new Date().toISOString(),
+      });
+    }
+    Assert.deepEqual(await PrivacyMetricsService.getHomepageStats(), { trackers: 21, cookies: 7 });
+    await writers[1].execute("UPDATE events SET count = count + 5 WHERE type = :type", { type: TrackingDBService.TRACKERS_ID });
+    Assert.deepEqual(await PrivacyMetricsService.getHomepageStats(), { trackers: 26, cookies: 7 });
+    for (const db of writers.splice(0)) { await db.close(); }
+    Assert.deepEqual(await PrivacyMetricsService.getHomepageStats(), { trackers: 26, cookies: 7 });
+    const db = await Sqlite.openConnection({ path: PathUtils.join(dirs[0].path, "protections.sqlite") });
+    await db.execute("DELETE FROM events");
+    await db.close();
+    Assert.deepEqual(await PrivacyMetricsService.getHomepageStats(), { trackers: 16, cookies: 4 });
+    profiles[1].remove(false);
+    profiles.pop();
+    Assert.deepEqual(await PrivacyMetricsService.getHomepageStats(), { trackers: 0, cookies: 0 });
+  } finally {
+    for (const db of writers) { await db.close(); }
+    for (const profile of profiles) { profile.remove(false); }
+  }
+});
